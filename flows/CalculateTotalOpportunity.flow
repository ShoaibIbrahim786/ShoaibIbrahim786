        <nextValueConnector>
            <targetReference>update_total</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>update_amount</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
